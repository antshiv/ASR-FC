/* The BLEDrone integration moves I2C away from these Arduino header pins. */
&i2c1 {
	status = "disabled";
};

/ {
	zephyr,user {
		ads1234-sclk-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>; /* D15/SCL */
		ads1234-dout-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>; /* D14/SDA */
		ads1234-pdwn-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; /* D2 */
	};
};
